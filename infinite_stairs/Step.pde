// =================================
//  Step.pde  階段の「1段」のデータ
// =================================
// 段1つぶんの情報(位置と幅)だけを持つ、いちばん小さなクラス。
// new Step(...) と書くと、段が1つ作られる。
class Step {
  float cx;   // 段の中心の x 座標
  float y;    // 段の「上面」の y 座標(アバターはこの高さに足を置く)
  float w;    // 段の横幅

  // コンストラクタ: new Step(中心x, 高さy, 幅w) と書いたときに呼ばれ、値を設定する
  // this.cx は「この段自身の cx」、右辺の cx は「引数で渡された値」を指す
  Step(float cx, float y, float w) {
    this.cx = cx;
    this.y = y;
    this.w = w;
  }

  // 段の左端の x 座標を返す(四角を描くときは、左端から描き始めるため)
  float left() {
    return cx - w / 2;
  }
}
