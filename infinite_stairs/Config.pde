// =====================================================================
//  Config.pde  調整用の数値(定数)
// =====================================================================
//  ここの数字を変えると、ゲームの感触や見た目が変わる。
//  final が付いた変数は「定数」で、プログラムの途中では変えられない。
//  すべてのタブから、名前だけで参照可。
// =====================================================================

// ---- 階段の形・動きの速さ ----
final int FPS = 60;               // 1秒間に画面を描き直す回数。スタミナの減る速さもこの値を基準に計算している
final float PITCH = 110;          // 次の段の中心までの「横」の距離。左右どちらかにこの分ずれる
final float TREAD = 100;          // 段1つの横幅
final float RISE  = 55;           // 1段ごとの「高さ」の差(次の段は55px上に置かれる)
final float THICK = 12;           // 段の厚み(見た目だけ)
final float START_W = 260;        // スタート地点(0段目)の足場の幅
final float FOLLOW = 0.29;        // アバターが次の段へ移る速さ(0〜1。大きいほど速い。)
final float CAMERA_FOLLOW = 0.10; // カメラがアバターを追う速さ(0〜1。大きいほど速い。)

// ---- スタミナ: 止まっていると減り、登ると少し回復する。段数が増えるほど減る速さも増す ----
final float STAMINA_MAX   = 100;   // スタミナの最大値
final float DECAY_BASE    = 12;    // 0段目付近での、1秒あたりの減少量
final float DECAY_PER_STEP = 0.15; // 段数が1増えるごとに、「1秒あたりの減少量」へ足される値
final float RECOVER       = 6;     // 1段登るごとの回復量
final float MISS_PENALTY  = 50;    // 向きを間違えたときに減るスタミナ

// ---- 自己ベストの保存先 ----
final String BEST_FILE = "best.txt";   // 自己ベストを書き込むファイル名(スケッチ内の data フォルダに作られる)

// ---- 空の色(天空の塔) ----
// 登った段数に応じて 昼 → 午後 → 夕焼け → 黄昏 → 夜 → 深夜 → 宇宙 へ変わっていく。
// 各場面ごとに「上・中・下」の3色を持ち、場面と場面の間は色をなめらかにつなぐ。
// 下の4つの配列は、同じ位置(0番目、1番目 ...)の要素が同じ場面のものになっている。
final int SPACE_AT = 300;         // この段数に達すると、完全に宇宙の色になる
final int[] SKY_AT     = { 0,       50,      100,     150,     200,     260,     SPACE_AT }; // 各場面になる段数
final int[] SKY_TOP    = { #4A90D9, #5F8FE0, #7A62B8, #3F3A8C, #14183F, #070A24, #02030C };  // 空の「上側」の色
final int[] SKY_MID    = { #8CC4EE, #A9C4EA, #E8808A, #8C4C96, #2C2A68, #121538, #060818 };  // 空の「真ん中」の色
final int[] SKY_BOTTOM = { #BFE3F7, #F7E3B5, #FF9A62, #D86A8E, #4A3C8C, #20204F, #0B0E2B };  // 空の「下側」の色

// ---- 星 ----
final int STAR_COUNT = 90;        // 星の数
final int STAR_FADE_START = 190;  // この段数あたりから星が見え始める
final int STAR_FADE_END   = 260;  // この段数でくっきり見える

// ---- ゲームの状態 ----
// ゲームは「今どの画面か」という状態(state)を1つ持っていて、状態によって処理を切り替える。
//   TITLE  = タイトル画面
//   PLAY   = プレイ中
//   PAUSE  = ポーズ中
//   RESULT = ゲームオーバー後のリザルト画面
// 数字(0〜3)をそのまま書くと分かりにくいので、名前を付けている。
final int TITLE = 0, PLAY = 1, PAUSE = 2, RESULT = 3;
