// ==========
//  無限階段   
// ==========
//
//    infinite_stairs.pde (このタブ) … 起動と毎フレームの入口。Gameに仕事を渡すだけ
//    Config.pde      … 調整用の数値(定数)。ゲームの難しさや見た目を変えたいときはここ
//    Game.pde        … ゲーム全体の進行役。状態(タイトル/プレイ中など)、キー入力、各部品のつなぎ役
//    Step.pde        … 階段の「1段」のデータ
//    Stairs.pde      … 階段全体(段の生成・描画・雲の土台)
//    Avatar.pde      … 宇宙服のアバター(位置・向き・動き・描画)
//    Stamina.pde     … スタミナ(減る・回復する・尽きる)
//    Camera.pde      … カメラ(アバターを追いかける)
//    Sky.pde         … 空(グラデーションと星)
//    Hud.pde         … 画面に重ねる表示(スコア、ゲージ、タイトル、リザルト)
//    BestScore.pde   … 自己ベストのファイル保存と読み込み
//
//  ■ 操作
//    A = 左の段へ / D = 右の段へ / R = リスタート / P = ポーズ / ENTER か SPACE = 決定
//    ※ 日本語入力(IME)がオンだとキーが届かないので、半角英数にして遊んでください
//
// =====================================================================


// ゲーム全体を管理するオブジェクト。ゲームの中身はすべて Game クラスの中にある
Game game;

// 起動したときに1回だけ実行される
void setup() {
  size(960, 600);          // ウィンドウの大きさ(横960px、縦600px)
  frameRate(FPS);          // 1秒間に FPS 回(60回)draw() を実行するよう指定
  game = new Game();       // Game クラスから、ゲーム本体を1つ作る(中で各部品も作られる)
}

// 毎フレーム(1秒に60回)くり返し実行される
void draw() {
  game.update();           // ゲームの中身を少し進める
  game.draw();             // 今の状態を画面に描く
}

// キーが押された瞬間に呼ばれる。処理は Game に任せる
void keyPressed() {
  game.keyPressed();
}

// キーが離された瞬間に呼ばれる
void keyReleased() {
  game.keyReleased();
}

// ウィンドウがアクティブでなくなったとき(別のウィンドウに切り替えたときなど)に呼ばれる
// game が作られる前に呼ばれても止まらないよう、null(まだ無い)かどうかを確認している
void focusLost() {
  if (game != null) game.onFocusLost();
}

// ウィンドウを閉じたとき・Escキーで終了したときに呼ばれる
void exit() {
  if (game != null) game.onExit();
  super.exit();            // 本来の終了処理を実行する(これを書かないと終了できない)
}
